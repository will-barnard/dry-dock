ORCHESTRATOR_URL=wss://drydock.your-domain.com/ws/worker
WORKER_SHARED_SECRET=replace-me
WORKER_NAME=macbook-coder-1
WORKER_POOL=coder
HARDWARE_CLASS=macbook
RAM_GB=64
MAX_CONTEXT=32768
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen2.5-coder:32b
# GitHub credential for cloning private repos. Workers only need read access
# (they never push — the orchestrator does). Use the same PAT you set in
# Beachhead's GITHUB_TOKEN, or a separate read-only PAT for the workers.
# Leave both empty if every project you'll run is public.
GITHUB_TOKEN=
GITHUB_USERNAME=
# Optional: only set on machines with a discrete GPU (e.g. Windows + RTX 3080).
# Macs use unified memory — leave these unset.
# GPU_VRAM_GB=12
# GPU_MODEL=RTX 3080
# Optional: change where this worker stores ephemeral clones on the host.
# Defaults to ./worktrees inside the worker repo. Useful if you want a
# specific worker to write to a faster external SSD.
# WORKTREE_HOST_DIR=/Volumes/FastSSD/dry-dock/macbook-coder-1
