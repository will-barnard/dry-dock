{
  "description": "SDXL image-to-image. Encode a source image into latent space, then denoise from partway through instead of from pure noise. Output dimensions come from the source image, so width/height are deliberately not mapped. `denoise` is the control that matters: ~0.3 retouches, ~0.6 restyles, ~0.85 keeps little more than the composition.",
  "accepts_init_image": true,
  "map": {
    "checkpoint": ["4", "ckpt_name"],
    "prompt": ["6", "text"],
    "negative_prompt": ["7", "text"],
    "init_image": ["12", "image"],
    "batch": ["14", "amount"],
    "denoise": ["3", "denoise"],
    "seed": ["3", "seed"],
    "steps": ["3", "steps"],
    "cfg": ["3", "cfg"],
    "sampler": ["3", "sampler_name"],
    "scheduler": ["3", "scheduler"]
  },
  "graph": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 30,
        "cfg": 6.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 0.6,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["14", 0]
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["4", 1] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["4", 1] }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": { "image": "drydock_input.png" }
    },
    "13": {
      "class_type": "VAEEncode",
      "inputs": { "pixels": ["12", 0], "vae": ["4", 2] }
    },
    "14": {
      "class_type": "RepeatLatentBatch",
      "inputs": { "samples": ["13", 0], "amount": 1 }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "drydock", "images": ["8", 0] }
    }
  }
}
