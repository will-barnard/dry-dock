# dry-dock worker — Windows (RTX 5080), Darkroom imager
# Pool: imager
#
# ── Read before editing ────────────────────────────────────────────
# This worker is NOT like the others in this directory. It talks to
# ComfyUI on the host, not to Ollama, so MAX_CONTEXT / DEFAULT_MODEL /
# TEMPERATURE mean nothing to it.
#
# MAX_CONTEXT is set below anyway, and only to keep docker compose
# quiet: the shared compose file lists it without a default, so an env
# file that omits it makes compose warn on every up/restart/rebuild.
# (workers.sh also picks the alphabetically-first env file as the
# sentinel for `build`, which on this machine is this one — so omitting
# it warns during builds too.) The value is ignored by an imager; it is
# NOT a fleet-consistency knob here the way it is on the Mac. It never
# clones a repo and never asks for task work — image jobs are pushed
# to it, not claimed.
#
# ComfyUI MUST be started with `--listen 0.0.0.0`. It binds 127.0.0.1
# by default, and this container reaching host.docker.internal:8188 is
# not localhost from ComfyUI's point of view — you'd get an imager
# that registers with zero checkpoints and fails every render. Note
# that run_nvidia_gpu.bat does not forward arguments; use a custom
# run_drydock.bat instead (see docs/DARKROOM-SETUP.md).
#
# Copy this file to windows-imager-1.env and fill in the shared secret
# (copy it from any other env file in this directory).
# ───────────────────────────────────────────────────────────────────

ORCHESTRATOR_URL=wss://drydock.bonetothebad.com/ws/worker
WORKER_SHARED_SECRET=<same value as the other workers>
WORKER_NAME=windows-imager-1
WORKER_POOL=imager

# Keep this identical to the other Windows workers so the dashboard's
# wake/shutdown cross-reference recognises the machine as online.
# Ignored by the imager. Present only to keep compose from warning —
# see the header. Any valid integer works.
MAX_CONTEXT=32768

HARDWARE_CLASS=windows-rtx5080
RAM_GB=32
GPU_VRAM_GB=16
GPU_MODEL=RTX 5080

# ComfyUI on this host.
COMFYUI_BASE_URL=http://host.docker.internal:8188
# Optional. Blank → whatever the workflow template names, and failing
# that the first checkpoint ComfyUI reports. A name that isn't
# installed falls back to one that is rather than failing the render.
COMFYUI_DEFAULT_CHECKPOINT=
# Ceiling for one render including a cold checkpoint load.
COMFYUI_TIMEOUT_SECONDS=300
# How long to wait for ComfyUI to answer before registering. Matters on a
# machine that reboots: this container comes back with Docker, usually
# before ComfyUI has finished starting, and registering in that window
# would advertise zero checkpoints.
COMFYUI_STARTUP_WAIT_SECONDS=240

LOG_LEVEL=INFO
